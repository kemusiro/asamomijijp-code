(text "P2 clean sheet schematic review H /2026-11-18 / NOT FOR FABRICATION" (at 15 255 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid faaea4e7-754b-574e-bf0b-5d0ecd4e7f79))
(text "G40 interface KEY6; new base GPIO0..7 data,8..11control,14..18audio. Old boards incompatible." (at 15 260 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 6652581d-eacc-57d8-8293-df00195e8bfc))
(text "Base PGA2350 + common PCM1863ADC + PCM5102A; source Core2350B0 + YM2203 + passiveSSG mix." (at 15 265 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 13d5bd8f-2270-5b32-87fc-c5bbc8eadf80))
(text "DAC_XSMT = DAC_ALLOW AND LINE_ALLOW; 4ms mute guard, keep audio clocks running on normal STOP." (at 15 270 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 8f6c8906-5842-59a2-8d98-2cfd5df53ee3))
(text "ADC IO/core uses PGA3V3, analog/PLL uses AUX; no ADC rail cycling or TMUX. Observe input and rail transients." (at 15 275 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 09c94b1e-4b7e-579d-bb20-6c104ce57aaa))
(text "Source control translator also carries YMclock and reset; default OE disabled, RESET pulled low." (at 15 280 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 3b5f5ae5-524c-5a39-aa1c-e8b1a6da0614))
(text "HOST0x42/100kHz and USB-MIDI/UNO retained as requirements; firmware/PCB/new bench acceptance pending." (at 15 285 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid 93830501-1412-524d-a636-29a5d122d041))
