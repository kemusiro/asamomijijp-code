+// F1: enforce a zero after six ones, including the PID tail. The upstream
+// destuffer removes a stuffed position without checking its value.
+reg stuff_armed;
+reg[2:0] stuff_ones;
+assign xstuff_error = nrzi_strobe && stuff_armed && !se0 && stuff_ones == 6 && d;
+always @(posedge clk_48 or negedge rst_n) begin
+    if (!rst_n) begin stuff_armed <= 0; stuff_ones <= 0; end
+    else if (nrzi_strobe) begin
+        if (se0) begin stuff_armed <= 0; stuff_ones <= 0; end
+        else if (sync_seq) begin stuff_armed <= 1; stuff_ones <= d ? 1 : 0; end
+        else if (stuff_armed) begin
+            if (!d) stuff_ones <= 0;
+            else if (stuff_ones < 6) stuff_ones <= stuff_ones + 1'b1;
+        end
+    end
