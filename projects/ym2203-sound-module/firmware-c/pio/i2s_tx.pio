; Adapted from pico-extras pico_audio_i2s/audio_i2s.pio (8-instruction program).
; License: ../THIRD_PARTY_LICENSES.txt. Two sideset bits: GP11=BCLK,GP12=LRCK.
.program i2s_tx
.side_set 2
.wrap_target
right_bits:
    out pins, 1      side 0b10
    jmp x-- right_bits side 0b11
    out pins, 1      side 0b00
public entry:
    set x, 14        side 0b01
left_bits:
    out pins, 1      side 0b00
    jmp x-- left_bits side 0b01
    out pins, 1      side 0b10
    set x, 14        side 0b11
.wrap
